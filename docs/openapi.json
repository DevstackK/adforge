{
  "openapi": "3.1.0",
  "info": {
    "title": "AdForge AI API",
    "version": "1.0.0",
    "description": "Organization-scoped API for creative generation, campaign orchestration and analytics."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "clerkSession": [] }, { "apiKey": [] }],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "operationId": "health",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/openapi": {
      "get": {
        "security": [],
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProject" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{id}": {
      "patch": {
        "operationId": "updateProject",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "description": {
                    "type": ["string", "null"],
                    "maxLength": 1000
                  },
                  "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/products/{id}": {
      "patch": {
        "operationId": "updateProduct",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProduct" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/products/import": {
      "post": {
        "operationId": "importProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["projectId", "url"],
                "properties": {
                  "projectId": { "type": "string" },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/copy/generate": {
      "post": {
        "operationId": "generateCopy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CopyRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "402": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/media/generate": {
      "post": {
        "operationId": "generateMedia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MediaRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "402": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/generations": {
      "get": {
        "operationId": "listGenerations",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/assets": {
      "get": {
        "operationId": "listAssets",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "registerAsset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterAsset" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/assets/{id}": {
      "get": {
        "operationId": "downloadAsset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "307": {
            "description": "Redirect to a short-lived signed download URL"
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteAsset",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/uploads/presign": {
      "post": {
        "operationId": "presignUpload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filename", "contentType", "bytes"],
                "properties": {
                  "filename": { "type": "string" },
                  "contentType": { "type": "string" },
                  "bytes": { "type": "integer", "maximum": 500000000 }
                }
              }
            }
          }
        },
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createCampaign",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CampaignRequest" }
            }
          }
        },
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/campaigns/publish": {
      "post": {
        "operationId": "publishCampaign",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["campaignId"],
                "properties": { "campaignId": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/Success" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/campaigns/{id}": {
      "patch": {
        "operationId": "setCampaignStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCampaign" }
            }
          }
        },
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "delete": {
        "operationId": "deleteDraftCampaign",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/analytics": {
      "get": {
        "operationId": "getAnalytics",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            }
          }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/brand-kits": {
      "get": {
        "operationId": "listBrandKits",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createBrandKit",
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/brand-kits/{id}": {
      "patch": {
        "operationId": "updateBrandKit",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BrandKit" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteBrandKit",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/team": {
      "get": {
        "operationId": "listTeam",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "inviteTeamMember",
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      },
      "patch": {
        "operationId": "updateTeamMember",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "delete": {
        "operationId": "removeTeamMember",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/connections": {
      "get": {
        "operationId": "listAdConnections",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "patch": {
        "operationId": "configureAdConnection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionConfiguration"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/connections/{platform}/start": {
      "get": {
        "operationId": "startAdPlatformOAuth",
        "parameters": [{ "$ref": "#/components/parameters/Platform" }],
        "responses": {
          "302": { "description": "Redirect to provider authorization" }
        }
      }
    },
    "/connections/{platform}/callback": {
      "get": {
        "operationId": "completeAdPlatformOAuth",
        "parameters": [
          { "$ref": "#/components/parameters/Platform" },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": { "description": "Redirect to connection settings" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api-keys": {
      "get": {
        "operationId": "listApiKeys",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createApiKey",
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      },
      "delete": {
        "operationId": "revokeApiKey",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "patch": {
        "operationId": "markNotificationsRead",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/support": {
      "get": {
        "operationId": "listSupportTickets",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createSupportTicket",
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/usage": {
      "get": {
        "operationId": "getUsageAndCredits",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/billing/checkout": {
      "post": {
        "operationId": "createCheckout",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/billing/portal": {
      "post": {
        "operationId": "createBillingPortalSession",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchWorkspace",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 2, "maxLength": 100 }
          }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/features": {
      "get": {
        "operationId": "getClientFeatureFlags",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/admin/summary": {
      "get": {
        "operationId": "getAdminSummary",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/admin/monitoring": {
      "get": {
        "operationId": "getAdminMonitoring",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/admin/resources": {
      "get": {
        "operationId": "listAdminResources",
        "parameters": [
          {
            "name": "resource",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["users", "subscriptions", "flags", "tickets", "logs"]
            }
          }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "patch": {
        "operationId": "updateAdminResource",
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "operationId": "createFeatureFlag",
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clerkSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "AdForge API key (af_*)"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "Platform": {
        "name": "platform",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": ["meta", "google", "tiktok", "pinterest", "linkedin"]
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": { "data": {} }
            }
          }
        }
      },
      "Error": {
        "description": "Structured error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string", "format": "uuid" },
              "details": {}
            }
          }
        }
      },
      "CreateProject": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      },
      "UpdateProduct": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "maxLength": 10000 },
          "sourceUrl": { "type": ["string", "null"], "format": "uri" },
          "price": { "type": ["number", "null"], "minimum": 0 },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "imageUrls": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "format": "uri" }
          }
        }
      },
      "RegisterAsset": {
        "type": "object",
        "required": ["key", "name", "type", "mimeType"],
        "properties": {
          "projectId": { "type": "string" },
          "key": { "type": "string", "maxLength": 1000 },
          "name": { "type": "string", "maxLength": 255 },
          "type": {
            "type": "string",
            "enum": ["IMAGE", "VIDEO", "AUDIO", "LOGO", "FONT", "DOCUMENT"]
          },
          "mimeType": { "type": "string", "maxLength": 120 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 1 }
        }
      },
      "BrandKit": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "colors": {
            "type": "object",
            "required": ["primary", "secondary", "accent"],
            "properties": {
              "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "secondary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          },
          "typography": {
            "type": "object",
            "required": ["heading", "body"],
            "properties": {
              "heading": { "type": "string" },
              "body": { "type": "string" }
            }
          },
          "voice": {
            "type": "object",
            "properties": {
              "tone": { "type": "array", "items": { "type": "string" } },
              "forbiddenTerms": {
                "type": "array",
                "items": { "type": "string" }
              },
              "productClaims": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "logoAssetId": { "type": ["string", "null"] },
          "isDefault": { "type": "boolean" }
        }
      },
      "ConnectionConfiguration": {
        "type": "object",
        "required": ["connectionId"],
        "properties": {
          "connectionId": { "type": "string" },
          "pageId": { "type": "string", "maxLength": 100 },
          "pixelId": { "type": "string", "maxLength": 100 },
          "appId": { "type": "string", "maxLength": 100 },
          "identityId": { "type": "string", "maxLength": 200 },
          "boardId": { "type": "string", "maxLength": 200 }
        }
      },
      "CopyRequest": {
        "type": "object",
        "required": ["projectId", "kind", "brief", "audience", "tone"],
        "properties": {
          "projectId": { "type": "string" },
          "productId": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "HEADLINE",
              "PRIMARY_TEXT",
              "CTA",
              "DESCRIPTION",
              "EMAIL",
              "LANDING_PAGE",
              "BLOG",
              "SEO",
              "CREATIVE_IDEA",
              "AUDIENCE",
              "HOOK",
              "OFFER",
              "IMAGE_PROMPT",
              "VIDEO_SCRIPT",
              "VOICEOVER",
              "CAPTION"
            ]
          },
          "brief": { "type": "string", "minLength": 10 },
          "audience": { "type": "string" },
          "tone": { "type": "string" },
          "language": { "type": "string", "default": "en" },
          "variants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          }
        }
      },
      "MediaRequest": {
        "type": "object",
        "required": ["projectId", "kind", "prompt"],
        "properties": {
          "projectId": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO",
              "BACKGROUND_REMOVE",
              "BACKGROUND_REPLACE",
              "PRODUCT_ENHANCE",
              "LIFESTYLE",
              "CAROUSEL",
              "UGC_VIDEO",
              "SLIDESHOW",
              "TALKING_AVATAR",
              "PRODUCT_SHOWCASE"
            ]
          },
          "prompt": { "type": "string", "minLength": 10 },
          "options": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": ["square", "portrait", "landscape", "story"]
              },
              "sourceAssetId": { "type": "string" },
              "avatarId": { "type": "string" },
              "voiceId": { "type": "string" },
              "musicUrl": { "type": "string", "format": "uri" },
              "carouselSlides": {
                "type": "array",
                "minItems": 2,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["headline", "prompt"],
                  "properties": {
                    "headline": { "type": "string", "maxLength": 90 },
                    "prompt": { "type": "string", "maxLength": 1000 }
                  }
                }
              },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["durationSeconds", "script"],
                  "properties": {
                    "durationSeconds": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 30
                    },
                    "script": { "type": "string", "maxLength": 500 },
                    "caption": { "type": "string", "maxLength": 200 },
                    "transition": {
                      "type": "string",
                      "enum": ["fade", "slide", "zoom"]
                    },
                    "backgroundAssetId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "CampaignRequest": {
        "type": "object",
        "required": [
          "projectId",
          "platform",
          "name",
          "objective",
          "dailyBudget",
          "audience",
          "creativeAssetIds",
          "copy"
        ],
        "properties": {
          "projectId": { "type": "string" },
          "platform": {
            "type": "string",
            "enum": ["META", "GOOGLE", "TIKTOK", "PINTEREST", "LINKEDIN"]
          },
          "name": { "type": "string" },
          "objective": { "type": "string" },
          "dailyBudget": { "type": "number", "exclusiveMinimum": 0 },
          "creativeFormat": {
            "type": "string",
            "enum": ["SINGLE", "CAROUSEL"],
            "default": "SINGLE"
          },
          "audience": { "type": "object" },
          "creativeAssetIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "copy": { "type": "object" }
        }
      },
      "UpdateCampaign": {
        "oneOf": [
          {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "string", "enum": ["ACTIVE", "PAUSED"] }
            }
          },
          {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "name": { "type": "string", "minLength": 3, "maxLength": 160 },
              "objective": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "dailyBudget": { "type": "number", "exclusiveMinimum": 0 },
              "lifetimeBudget": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              }
            }
          }
        ]
      }
    }
  }
}

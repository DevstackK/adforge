NODE_ENV=production
APP_URL=https://app.adforge.example
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/adforge?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@PRIVATE_HOST:6379
LOG_LEVEL=info
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
OPENAI_API_KEY=sk-replace_me
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
HEYGEN_API_KEY=replace_me
META_APP_ID=replace_me
META_APP_SECRET=replace_me
GOOGLE_ADS_CLIENT_ID=replace_me
GOOGLE_ADS_CLIENT_SECRET=replace_me
GOOGLE_ADS_DEVELOPER_TOKEN=replace_me
TIKTOK_APP_ID=replace_me
TIKTOK_APP_SECRET=replace_me
PINTEREST_APP_ID=replace_me
PINTEREST_APP_SECRET=replace_me
LINKEDIN_CLIENT_ID=replace_me
LINKEDIN_CLIENT_SECRET=replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_GROWTH=price_replace_me
STRIPE_PRICE_SCALE=price_replace_me
AWS_REGION=us-east-1
S3_BUCKET=adforge-production
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=false
ENCRYPTION_KEY=replace_with_32_byte_base64_key
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318
OTEL_SERVICE_NAME=adforge-web
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
